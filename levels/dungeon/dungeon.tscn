[node name="StartingTutorial" parent="Which way?" index="7" unique_id=1204220795 instance=ExtResource("13_45rdo")]
text = Array[String](["Welcome! You must be here to destroy the evil in this place!", "Many have tried many have died!", "But I'm sure you're built different!", "Even though you are strong as a wet noodle!", "And without any abilities whatsoever!", "You don't even have a weapon!", "Worry not! You can find magical abilities in here!", "Other stuff too, including money and shops!", "First things first though!", "Look for the jump skill!", "It should help you navigate this place better!", "And gather money to buy a sword!", "Then nobody can stop you!", "Also fwi press 'P' (or 'Start' on a controller) to pause.", "On the pause screen you can review the controls.", "You can also see your status, your upgrades...", "And kill yourself! Most useful!", "Feel free to ask me for any more tips!", "Who am I?", "Why, I'm the friendly floating mask to your left!", "Good luck! I'm sure you'll do great!"])

