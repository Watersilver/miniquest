[sub_resource type="Resource" id="Resource_8gipd"]
script = ExtResource("11_lcler")
text = Array[String](["They say a man who will save humanity if given enough money lives somewhere around here!", "Don't hesitate to give him everything you've got!", "It's sure to pay off long term!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_6nkwe"]
script = ExtResource("12_r6hda")
flags = Array[String](["tower_dead"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_45rdo"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_6nkwe")])
text = Array[String](["The master of the tower is rather  inhospitable!", "Be ready for a tough fight if you bother him!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_1sl7l"]
script = ExtResource("12_r6hda")
flags = Array[String](["slime_dead"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_j07vi"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_1sl7l")])
text = Array[String](["In the dungeons below lives the big slime!", "It's sure to slime you!", "But it's the least threatening of the most threatening creatures in here!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_8wk3b"]
script = ExtResource("12_r6hda")
flags = Array[String](["armed"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_ltbnm"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_8wk3b")])
text = Array[String](["You really ought to get yourself a weapon!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_y1st8"]
script = ExtResource("11_lcler")
text = Array[String](["Get yourself as much health as you can!", "But only if you're not a Bad Enough Dude!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_f530s"]
script = ExtResource("12_r6hda")
flags = Array[String](["controlled_fall", "double_jump"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_8dxlx"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_f530s")])
text = Array[String](["The shops are selling jump upgrades that are sure to make your life easier!", "As easy as the life of a FILTHY CASUAL that is!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_816ma"]
script = ExtResource("11_lcler")
text = Array[String](["Jumping while dashing makes you jump farther!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_5150b"]
script = ExtResource("11_lcler")
text = Array[String](["Some walls and floors in this place are illusory!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_u02v0"]
script = ExtResource("12_r6hda")
flags = Array[String](["knight_dead"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_lb4on"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_u02v0")])
text = Array[String](["An wight knight is somewhere around here!", "They say fairies and/or witches can reach him though!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_3a8rt"]
script = ExtResource("12_r6hda")
flags = Array[String](["mage_dead"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_j5xha"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_3a8rt")])
text = Array[String](["The lich witch is guarding a very powerful stuff!", "You should definitely ask her for it!", "She has a pet and people with pets are very kind and generous!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_12qeb"]
script = ExtResource("12_r6hda")
flags = Array[String](["element_ice"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_8muwk"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_12qeb")])
text = Array[String](["Somewhere in the dungeon below, you can learn how to freeze your enemies and turn them into solid ice blocks!", "The you can use them as platforms!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_oopsy"]
script = ExtResource("12_r6hda")
flags = Array[String](["green_switch"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_xim1i"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_oopsy")])
text = Array[String](["On top of the tower is the green switch!", "Pressing it will turn solid green blocks intangible and intangible green blocks walkable!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_xdg2q"]
script = ExtResource("12_r6hda")
flags = Array[String](["knight_dead"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_r765m"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_xdg2q")])
text = Array[String](["An undead knight is waiting for a worthy opponent!", "Surely that's you!", "You will easily defeat him."])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_mmtmo"]
script = ExtResource("12_r6hda")
flags = Array[String](["element_fire"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_8rylj"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_mmtmo")])
text = Array[String](["The greedy shopkeeper is selling some kind of powerful potion!", "Or so he says!", "I bet it's worthless!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_rosrk"]
script = ExtResource("11_lcler")
text = Array[String](["Some demonic enemies hit with advantage!", "That means that reality itself thinks twice about how much they damage you and picks the worse outcome!", "An amulet that  gives you defensive advantage is said to guard from this!", "I say it's best to just not get hit!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_unoni"]
script = ExtResource("11_lcler")
text = Array[String](["The green mage is exactly below us!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_qojhe"]
script = ExtResource("11_lcler")
text = Array[String](["Many switches create shortcuts!", "Remember to hit them!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_gvuow"]
script = ExtResource("12_r6hda")
flags = Array[String](["mage_dead"])
metadata/_custom_type_script = "uid://be8pn6p3sds21"

[sub_resource type="Resource" id="Resource_q48rh"]
script = ExtResource("11_lcler")
disabled_by_any_of = Array[ExtResource("12_r6hda")]([SubResource("Resource_gvuow")])
text = Array[String](["The old lich witch is surely in a magical realm!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_tf0x8"]
script = ExtResource("11_lcler")
text = Array[String](["Let's talk about down!", "Holding down on the ground allows you to turn around without moving!", "Holding down on the air makes you descend faster if you have the controlled jump upgrade!", "Holding down and jump allows you to drop through semisolids even if you can't jump!", "Wasn't all that informative?"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_6mcr3"]
script = ExtResource("11_lcler")
text = Array[String](["If you somehow manage to generate enough force to shake the environment, certain light objects that are lying on the ground are sure to get thrown around!"])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

[sub_resource type="Resource" id="Resource_kwc3y"]
script = ExtResource("11_lcler")
text = Array[String](["The room hists could sometimes be malicious... Trust me..."])
metadata/_custom_type_script = "uid://cw0odipsmjemt"

